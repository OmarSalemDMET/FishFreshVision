{:paths ["src" "resources" "src/java" "classes" "test"]
 :deps  {org.clojure/clojure            {:mvn/version "1.12.0"}
         org.clojure/core.async         {:mvn/version "1.6.681"}
         metosin/reitit                 {:mvn/version "0.7.2"}
         metosin/reitit-ring            {:mvn/version "0.7.2"}
         metosin/muuntaja               {:mvn/version "0.6.10"}
         metosin/malli                  {:mvn/version "0.16.2"}
         ring/ring-jetty-adapter        {:mvn/version "1.12.1"}
         org.babashka/sci               {:mvn/version "0.15.59"}

         ;; grpc and protobuf
         io.grpc/grpc-netty-shaded      {:mvn/version "1.76.0"}
         io.grpc/grpc-protobuf          {:mvn/version "1.76.0"}
         io.grpc/grpc-stub              {:mvn/version "1.76.0"}
         com.google.protobuf/protobuf-java {:mvn/version "3.25.1"}
         javax.annotation/javax.annotation-api {:mvn/version "1.3.2"}

         ;; --- restored ml dependencies ---
         org.uncomplicate/diamond-onnxrt {:mvn/version "0.24.0"
                                          :exclusions [org.bytedeco/cuda-platform
                                                       org.bytedeco/cuda]}
         org.uncomplicate/neanderthal-openblas {:mvn/version "0.60.0"
                                                :exclusions [org.bytedeco/cuda-platform
                                                             org.bytedeco/cuda]}
         org.bytedeco/onnxruntime$linux-x86_64 {:mvn/version "1.24.1-1.5.13"}
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.1070"}
         com.github.seancorfield/honeysql  {:mvn/version "2.7.1364"}
         org.postgresql/postgresql         {:mvn/version "42.7.8"}
         com.zaxxer/HikariCP {:mvn/version "6.2.0"}
         com.taoensso/timbre            {:mvn/version "6.8.0"}
         viesti/timbre-json-appender    {:mvn/version "0.2.14"}
         cheshire/cheshire                 {:mvn/version "5.13.0"} ;; for jsonb encoding/decoding
         org.slf4j/slf4j-nop {:mvn/version "2.0.12"}
         hiccup/hiccup {:mvn/version "1.0.5"}}
 :aliases
  {:test {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :main-opts   ["-m" "cognitect.test-runner"]
          :exec-fn     cognitect.test-runner.api/test}}

 }
